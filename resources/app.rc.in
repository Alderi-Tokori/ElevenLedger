#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"
IDR_MANIFEST RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PitchRate"
            VALUE "FileDescription", "PitchRate Football Rating Calculator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "PitchRate"
            VALUE "LegalCopyright", "Copyright (c) 2026 Vincent Bragard"
            VALUE "OriginalFilename", "PitchRate.exe"
            VALUE "ProductName", "PitchRate"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
